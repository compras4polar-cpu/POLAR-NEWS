{
  "crons": [
    { "path": "/api/cron-refresh", "schedule": "0 17 * * *" },
    { "path": "/api/send-daily-report", "schedule": "30 17 * * *" }
  ],
  "functions": {
    "api/send-daily-report.js": { "maxDuration": 60, "memory": 1024 },
    "api/generate-report.js": { "maxDuration": 60, "memory": 1024 },
    "api/cron-refresh.js": { "maxDuration": 60, "memory": 1024 }
  }
}
