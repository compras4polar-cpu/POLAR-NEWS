# Copie este arquivo para ".env.local" para testar localmente com `vercel dev`.
# Em produção, estas variáveis são cadastradas no painel do Vercel:
# Project Settings > Environment Variables — NUNCA commitar valores reais no Git.

# --- Obrigatórias para o refresh automático funcionar de fato ---

# Gratuita — registre em https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Persistência via GitHub (em vez de um banco externo) — token com escopo
# de escrita no repositório (o mesmo padrão gerado por `gh auth token`
# funciona) e o nome "dono/repositorio".
GITHUB_TOKEN=
GITHUB_REPO=compras4polar-cpu/POLAR-NEWS
GITHUB_DATA_PATH=data/live-snapshot.json

# --- Obrigatórias somente se quiser o e-mail diário em PDF ---

# Gratuita — crie conta em https://sendgrid.com e gere uma API key
SENDGRID_API_KEY=

# Precisa ser um remetente verificado no SendGrid (Single Sender Verification)
REPORT_EMAIL_FROM=

# Para onde o relatório diário será enviado
REPORT_EMAIL_TO=compras4.polar@gmail.com

# URL pública do painel já implantado (usada pelo Puppeteer para gerar o PDF)
DASHBOARD_PUBLIC_URL=https://compradores-polar.vercel.app

# --- Opcional — protege os endpoints de cron contra chamadas externas ---
# Gere uma string aleatória qualquer (ex.: openssl rand -hex 32)
CRON_SECRET=

# --- Opcionais — só preencher quando a Polar tiver assinatura paga ---
ICIS_API_KEY=
DREWRY_API_KEY=
LME_API_KEY=
